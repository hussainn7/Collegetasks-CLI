# iCollege Scraper Configuration
# Copy this file to .env and fill in your values

# ── iCollege ──────────────────────────────────────────
ICOLLEGE_URL=https://icollege.gsu.edu
D2L_BASE_URL=https://gastate.view.usg.edu
SAML_LOGIN_URL=https://gastate.view.usg.edu/d2l/lp/auth/saml/initiate-login?entityId=https://idp.gsu.edu/idp/shibboleth

# ── LLM (Google Gemini) ──────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Notifications (Telegram) ─────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-here
# Chat ID or @username — run "python main.py chatid" to find yours
TELEGRAM_CHAT_ID=

# ── Browser Settings ─────────────────────────────────
HEADLESS=true

# ── Storage Paths ─────────────────────────────────────
DB_PATH=data/icollege.db
BROWSER_PROFILE_PATH=data/browser_profile

# ── Course Filter (optional) ─────────────────────────
COURSE_FILTER=
