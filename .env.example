# iCollege Scraper Configuration
# Copy this file to .env and fill in your values

# ── iCollege ──────────────────────────────────────────
# Landing page (for reference only — NOT the actual D2L instance)
ICOLLEGE_URL=https://icollege.gsu.edu

# Actual D2L Brightspace LMS instance
D2L_BASE_URL=https://gastate.view.usg.edu

# SAML SSO login entry point
SAML_LOGIN_URL=https://gastate.view.usg.edu/d2l/lp/auth/saml/initiate-login?entityId=https://idp.gsu.edu/idp/shibboleth

# ── LLM (Google Gemini) ──────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Notifications ─────────────────────────────────────
# Discord webhook URL (optional — leave blank to skip)
DISCORD_WEBHOOK_URL=

# ── Browser Settings ─────────────────────────────────
# Run scans in headless mode (true/false)
HEADLESS=true

# ── Storage Paths ─────────────────────────────────────
DB_PATH=data/icollege.db
SESSION_PATH=data/session_state.json

# ── Course Filter (optional) ─────────────────────────
# Comma-separated list of course name substrings to scan.
# Leave blank to scan ALL enrolled courses.
# Example: COURSE_FILTER=CSC 1302,MATH 2211
COURSE_FILTER=
