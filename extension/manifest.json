{
  "manifest_version": 3,
  "name": "iCollege Organizer",
  "version": "1.0.0",
  "description": "Unified 'What's Due' checklist, class hider, and Google Calendar sync for iCollege.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "iCollege Organizer Settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gastate.view.usg.edu/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
